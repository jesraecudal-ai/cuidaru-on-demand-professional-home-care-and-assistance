{
  "name": "PaymentTransaction",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number"
    },
    "provider_payout": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "type": {
      "type": "string",
      "enum": [
        "escrow_deposit",
        "payout_released",
        "refund",
        "platform_fee"
      ],
      "description": "Transaction type"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "booking_id",
    "client_email",
    "amount",
    "type"
  ]
}