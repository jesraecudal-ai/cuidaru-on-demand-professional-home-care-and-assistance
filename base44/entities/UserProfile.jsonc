{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "client",
        "provider",
        "both"
      ],
      "default": "client"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL for the client user"
    },
    "company_name": {
      "type": "string",
      "description": "Optional company name for clients"
    },
    "company_logo_url": {
      "type": "string",
      "description": "Optional company logo URL for clients"
    },
    "position": {
      "type": "string",
      "description": "Job title or position at the company"
    },
    "address": {
      "type": "string",
      "description": "Client address"
    },
    "country": {
      "type": "string",
      "enum": [
        "brazil",
        "uruguay",
        "usa",
        "canada",
        "philippines"
      ],
      "default": "brazil"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "premium_expires_at": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Admin can disable/enable this user"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional profile description"
    },
    "id_document_url": {
      "type": "string",
      "description": "Client primary ID document photo/PDF"
    },
    "id_document_type": {
      "type": "string",
      "enum": [
        "cpf",
        "rg",
        "cnh",
        "cedula",
        "passport",
        "resident_card",
        "temp_id",
        "visa"
      ],
      "description": "Type of document"
    },
    "id_document_number": {
      "type": "string",
      "description": "Document number (optional)"
    },
    "id_secondary_url": {
      "type": "string",
      "description": "Secondary document (e.g. RG for Brazil)"
    },
    "id_verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified",
      "description": "Client ID verification status"
    }
  },
  "required": [
    "user_email",
    "role"
  ]
}