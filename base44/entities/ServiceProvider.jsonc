{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "caregiver",
        "assistant_nurse",
        "nurse",
        "doctor",
        "social_worker",
        "house_cleaner",
        "cook",
        "laundry_helper",
        "nanny",
        "errand_runner"
      ]
    },
    "bio": {
      "type": "string"
    },
    "experience_years": {
      "type": "number"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hourly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "weekly_rate": {
      "type": "number"
    },
    "location_text": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "country": {
      "type": "string",
      "enum": [
        "brazil",
        "uruguay",
        "usa",
        "canada"
      ],
      "default": "brazil"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "default": "available"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "premium_expires_at": {
      "type": "string"
    },
    "id_document_url": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_jobs": {
      "type": "number",
      "default": 0
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "category"
  ]
}