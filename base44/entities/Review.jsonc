{
  "name": "Review",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "client",
        "provider"
      ],
      "default": "client",
      "description": "Who wrote this review"
    },
    "reviewee_email": {
      "type": "string",
      "description": "Who is being reviewed"
    },
    "reviewee_name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional extended description for this review"
    },
    "provider_response": {
      "type": "string"
    }
  },
  "required": [
    "booking_id",
    "provider_id",
    "rating",
    "reviewer_role"
  ]
}