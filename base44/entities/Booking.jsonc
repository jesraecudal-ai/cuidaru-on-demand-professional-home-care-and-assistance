{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "duration": {
      "type": "number"
    },
    "rate_applied": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "platform_fee_pct": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "provider_payout": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description for this booking"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "counter_offered",
        "accepted",
        "paid_confirmed",
        "in_progress",
        "completed",
        "release_pending",
        "payment_released",
        "cancelled",
        "disputed",
        "refunded"
      ],
      "default": "pending_approval"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid_held",
        "release_pending",
        "released",
        "refunded",
        "disputed"
      ],
      "default": "unpaid"
    },
    "counter_offer_amount": {
      "type": "number",
      "description": "Latest counter offer total amount"
    },
    "counter_offer_by": {
      "type": "string",
      "description": "Email of who made the last counter offer"
    },
    "counter_offer_note": {
      "type": "string"
    },
    "counter_offer_booking_type": {
      "type": "string"
    },
    "counter_offer_duration": {
      "type": "number"
    },
    "counter_offer_start_date": {
      "type": "string"
    },
    "auto_release_at": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    },
    "disputed_by": {
      "type": "string"
    },
    "admin_resolution": {
      "type": "string"
    },
    "country": {
      "type": "string"
    }
  },
  "required": [
    "client_email",
    "provider_id",
    "booking_type",
    "start_date"
  ],
  "rls": {
    "create": {
      "data.client_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.provider_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.provider_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}