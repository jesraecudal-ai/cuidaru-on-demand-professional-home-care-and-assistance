{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "caregiver",
          "assistant_nurse",
          "nurse",
          "doctor",
          "social_worker",
          "house_cleaner",
          "cook",
          "laundry_helper",
          "nanny",
          "errand_runner",
          "tutor",
          "teacher",
          "sports_teacher",
          "gym"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "description": "Up to 6 service categories"
    },
    "category": {
      "type": "string",
      "description": "Deprecated - use categories instead"
    },
    "bio": {
      "type": "string"
    },
    "experience_years": {
      "type": "number"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hourly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "weekly_rate": {
      "type": "number"
    },
    "consultation_fee": {
      "type": "number",
      "description": "One-time consultation fee for doctors"
    },
    "location_text": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "country": {
      "type": "string",
      "enum": [
        "brazil",
        "uruguay",
        "usa",
        "canada",
        "philippines"
      ],
      "default": "brazil"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "offline"
      ],
      "default": "available"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "premium_expires_at": {
      "type": "string"
    },
    "id_document_url": {
      "type": "string",
      "description": "Primary ID document photo"
    },
    "id_document_type": {
      "type": "string",
      "enum": [
        "cpf",
        "rg",
        "cnh",
        "cedula",
        "passport",
        "resident_card"
      ],
      "description": "Type of document uploaded"
    },
    "id_document_number": {
      "type": "string",
      "description": "Document number (optional)"
    },
    "id_secondary_url": {
      "type": "string",
      "description": "Secondary document"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_jobs": {
      "type": "number",
      "default": 0
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Admin can disable/enable this provider listing"
    }
  },
  "required": [
    "full_name",
    "categories"
  ]
}