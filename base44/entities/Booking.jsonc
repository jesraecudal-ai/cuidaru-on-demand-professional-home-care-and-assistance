{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "duration": {
      "type": "number"
    },
    "rate_applied": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "platform_fee_pct": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "provider_payout": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "accepted",
        "paid_confirmed",
        "in_progress",
        "completed",
        "release_pending",
        "payment_released",
        "cancelled",
        "disputed",
        "refunded"
      ],
      "default": "pending_approval"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid_held",
        "release_pending",
        "released",
        "refunded",
        "disputed"
      ],
      "default": "unpaid"
    },
    "auto_release_at": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    },
    "disputed_by": {
      "type": "string"
    },
    "admin_resolution": {
      "type": "string"
    },
    "country": {
      "type": "string"
    }
  },
  "required": [
    "client_email",
    "provider_id",
    "booking_type",
    "start_date"
  ]
}