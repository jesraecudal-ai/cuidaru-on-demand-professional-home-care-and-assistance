{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Format: clientEmail__providerId"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "client",
        "provider",
        "admin"
      ]
    },
    "content": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "content"
  ]
}