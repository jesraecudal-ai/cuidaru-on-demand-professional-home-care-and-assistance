{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Format: clientEmail__providerId"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "client",
        "provider",
        "admin"
      ]
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "counter_offer"
      ],
      "default": "text",
      "description": "text = normal chat, counter_offer = negotiation card"
    },
    "offer_booking_id": {
      "type": "string",
      "description": "The booking this counter offer belongs to"
    },
    "offer_amount": {
      "type": "number"
    },
    "offer_booking_type": {
      "type": "string"
    },
    "offer_duration": {
      "type": "number"
    },
    "offer_start_date": {
      "type": "string"
    },
    "offer_status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "superseded"
      ],
      "default": "pending",
      "description": "State of this specific counter offer message"
    },
    "client_email": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_email": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "sender_email",
    "content"
  ]
}